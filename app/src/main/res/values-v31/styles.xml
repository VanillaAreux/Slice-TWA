<resources>
    <style name="Theme.Launcher" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#ff5a1f</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111318</item>
        <item name="android:navigationBarColor">#111318</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">#FF5A1F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/slice_icon_foreground</item>
        <item name="android:postSplashScreenTheme">@style/Theme.Launcher</item>
    </style>
</resources>
